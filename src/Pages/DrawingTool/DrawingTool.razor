@page "/dwawingtool"
@layout Empty

<div class="drawing-tool">
  <div class="header">
    <span>ツール:</span>
    <button data-tool="freehand" class="active">フリーハンド</button>
    <button data-tool="rect">四角形</button>
    <button data-tool="circle">丸</button>
    <button data-tool="triangle">三角形</button>

    <span>色:</span>
    <button data-color="#000000" class="active">黒</button>
    <button data-color="#ff0000">赤</button>
    <button data-color="#00aa00">緑</button>
    <button data-color="#0000ff">青</button>

    <span>塗り:</span>
    <button data-fill="fill" class="active">塗りつぶし</button>
    <button data-fill="stroke">縁だけ</button>

    <span>文字サイズ:</span>
    <button data-font="16">小</button>
    <button data-font="24" class="active">中</button>
    <button data-font="40">大</button>

    <button id="clear">クリア</button>
  </div>

  <div id="canvas-wrapper">
    <svg id="drawingArea"></svg>
  </div>
</div>
